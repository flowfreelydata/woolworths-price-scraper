# Comma-separated search terms — this is what gets searched on woolworths.com.au
SEARCH_TERMS=milk 2l,white bread,eggs 12 pack
# Appended on top of SEARCH_TERMS — use this to add a batch of terms (e.g. a new
# category) without editing the main list.
SEARCH_TERMS_EXTRA=

# Cap on products captured per term (keeps each run's request volume small)
MAX_RESULTS_PER_TERM=24

# Where CSV/JSON output goes. On Railway this should be a mounted volume path.
OUTPUT_DIR=/data

# true = no visible browser window (required on Railway). Set false only for local debugging.
HEADLESS=true

# Optional but strongly recommended for reliability — see README "About the anti-bot claim".
# Format: http://user:pass@host:port  or  socks5://host:port
PROXY_SERVER=

LOCALE=en-AU
TZ_ID=Australia/Melbourne

# Random delay range between search terms, milliseconds.
MIN_DELAY_MS=8000
MAX_DELAY_MS=22000

NAV_TIMEOUT_MS=45000
RESULTS_TIMEOUT_MS=20000
MAX_RETRIES_PER_TERM=3

# Dumps blocked/empty-result page HTML to OUTPUT_DIR/debug for troubleshooting.
DEBUG_DUMPS=true

# Optional. When set, every run's rows are also inserted into Postgres
# (table `price_history`, created automatically) in addition to the CSV/JSON
# on the volume. On Railway, set this to a reference like
# ${{postgres.DATABASE_URL}} pointing at your Postgres service. Left unset,
# behavior is unchanged (CSV/JSON only).
DATABASE_URL=
